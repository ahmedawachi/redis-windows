diff --git a/src/win32_meminfo.c b/src/win32_meminfo.c
new file mode 100644
index 0000000..6605435
--- /dev/null
+++ b/src/win32_meminfo.c
@@ -0,0 +1,77 @@
+/*
+ * Win32 process and system memory counters for Cygwin/MSYS2 builds.
+ *
+ * Cygwin has no smaps, and /proc/self/stat reports RSS in 4 KB pages while
+ * sysconf(_SC_PAGESIZE) returns the 64 KB allocation granularity, so the
+ * Linux code paths in zmalloc.c would report nonsense. This file asks
+ * Windows directly. It includes only Win32 headers so that windows.h never
+ * meets the POSIX headers the rest of Redis uses.
+ *
+ * The K32* entry points live in kernel32.dll (Windows 7 and later), which the
+ * Cygwin and MSYS2 gcc drivers link by default, so no psapi import library
+ * is needed.
+ *
+ * Licensed under your choice of (a) the Redis Source Available License 2.0
+ * (RSALv2); or (b) the Server Side Public License v1 (SSPLv1); or (c) the
+ * GNU Affero General Public License v3 (AGPLv3).
+ */
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#undef PSAPI_VERSION
+#define PSAPI_VERSION 2   /* declare the kernel32 K32* names */
+#include <windows.h>
+#include <psapi.h>
+
+#include "win32_meminfo.h"
+
+int win32GetProcessMemory(win32ProcessMemory *pm) {
+    PROCESS_MEMORY_COUNTERS_EX pmc;
+
+    ZeroMemory(&pmc, sizeof(pmc));
+    pmc.cb = sizeof(pmc);
+    if (!K32GetProcessMemoryInfo(GetCurrentProcess(),
+                                 (PROCESS_MEMORY_COUNTERS *)&pmc, sizeof(pmc)))
+    {
+        pm->private_bytes = pm->working_set = 0;
+        return 0;
+    }
+    pm->private_bytes = pmc.PrivateUsage;
+    pm->working_set = pmc.WorkingSetSize;
+    return 1;
+}
+
+int win32GetSystemMemory(win32SystemMemory *sm) {
+    PERFORMANCE_INFORMATION pi;
+    MEMORYSTATUSEX ms;
+
+    ZeroMemory(&pi, sizeof(pi));
+    pi.cb = sizeof(pi);
+    if (K32GetPerformanceInfo(&pi, sizeof(pi))) {
+        sm->commit_total = pi.CommitTotal * pi.PageSize;
+        sm->commit_limit = pi.CommitLimit * pi.PageSize;
+        sm->phys_available = pi.PhysicalAvailable * pi.PageSize;
+        sm->source = "GetPerformanceInfo";
+        return 1;
+    }
+
+    /* GetPerformanceInfo also counts the handles and threads of every
+     * process, which may need a working buffer from the Windows heap, so it
+     * can fail under the very commit pressure we want to report.
+     * GlobalMemoryStatusEx needs no buffer. Its page file figures are capped
+     * by a job object's commit limit, when there is one. */
+    ZeroMemory(&ms, sizeof(ms));
+    ms.dwLength = sizeof(ms);
+    if (GlobalMemoryStatusEx(&ms)) {
+        sm->commit_limit = (size_t)ms.ullTotalPageFile;
+        sm->commit_total = (size_t)(ms.ullTotalPageFile - ms.ullAvailPageFile);
+        sm->phys_available = (size_t)ms.ullAvailPhys;
+        sm->source = "GlobalMemoryStatusEx";
+        return 1;
+    }
+
+    sm->commit_total = sm->commit_limit = sm->phys_available = 0;
+    sm->source = "unavailable";
+    return 0;
+}
diff --git a/src/win32_meminfo.h b/src/win32_meminfo.h
new file mode 100644
index 0000000..52fa8f0
--- /dev/null
+++ b/src/win32_meminfo.h
@@ -0,0 +1,34 @@
+/*
+ * Win32 process and system memory counters for Cygwin/MSYS2 builds.
+ *
+ * Licensed under your choice of (a) the Redis Source Available License 2.0
+ * (RSALv2); or (b) the Server Side Public License v1 (SSPLv1); or (c) the
+ * GNU Affero General Public License v3 (AGPLv3).
+ */
+
+#ifndef __WIN32_MEMINFO_H
+#define __WIN32_MEMINFO_H
+
+#include <stddef.h>
+
+/* Counters of the calling process, in bytes. */
+typedef struct win32ProcessMemory {
+    size_t private_bytes;   /* PrivateUsage: private commit charge */
+    size_t working_set;     /* WorkingSetSize: resident pages, shared DLL pages included */
+} win32ProcessMemory;
+
+/* System-wide commit and physical memory, in bytes. */
+typedef struct win32SystemMemory {
+    size_t commit_total;    /* committed by all processes and the kernel */
+    size_t commit_limit;    /* RAM plus page files: commits above it fail */
+    size_t phys_available;
+    const char *source;     /* "GetPerformanceInfo" or "GlobalMemoryStatusEx" */
+} win32SystemMemory;
+
+/* Both return 1 on success and 0 on failure, with every field zeroed (and
+ * source set to "unavailable"). Neither calls malloc, so both are safe to use
+ * from the out-of-memory handler. */
+int win32GetProcessMemory(win32ProcessMemory *pm);
+int win32GetSystemMemory(win32SystemMemory *sm);
+
+#endif
diff --git a/src/zmalloc.c b/src/zmalloc.c
index 61f428a..675c0bd 100644
--- a/src/zmalloc.c
+++ b/src/zmalloc.c
@@ -883,6 +883,15 @@ size_t zmalloc_get_rss(void) {
     close(fd);
     return info.pr_rssize;
 }
+#elif defined(HAVE_WIN32_MEMINFO)
+#include "win32_meminfo.h"
+
+size_t zmalloc_get_rss(void) {
+    win32ProcessMemory pm;
+
+    if (win32GetProcessMemory(&pm)) return pm.working_set;
+    return zmalloc_used_memory();
+}
 #else
 size_t zmalloc_get_rss(void) {
     /* If we can't get the RSS in an OS-specific way for this system just
@@ -1194,6 +1203,15 @@ size_t zmalloc_get_smap_bytes_by_field(char *field, long pid) {
  * call can be slow, exceeding 1000ms!
  */
 size_t zmalloc_get_private_dirty(long pid) {
+#if defined(HAVE_WIN32_MEMINFO)
+    /* Cygwin fork is not copy-on-write: the child starts with a private copy
+     * of the parent's heap, so its own private commit charge is what the fork
+     * cost. Only the calling process (pid -1) can be measured this way. */
+    if (pid == -1) {
+        win32ProcessMemory pm;
+        if (win32GetProcessMemory(&pm)) return pm.private_bytes;
+    }
+#endif
     return zmalloc_get_smap_bytes_by_field("Private_Dirty:",pid);
 }
 
