+++ b/src/config.c
@@ -2635,6 +2635,14 @@ static int isValidProcTitleTemplate(char *val, const char **err) {
 }
 
 /* Validate that array-slice-size is a power of two */
+static int isValidReplyNodeMaxBytes(long long val, const char **err) {
+    if (val != 0 && val < PROTO_REPLY_CHUNK_BYTES) {
+        *err = "must be 0 (replies are not split) or at least 16kb";
+        return 0;
+    }
+    return 1;
+}
+
 static int isValidArraySliceSize(long long val, const char **err) {
     if (val <= 0 || (val & (val - 1)) != 0) {
         *err = "array-slice-size must be a power of two";
@@ -3608,6 +3616,7 @@ standardConfig static_configs[] = {
     createSizeTConfig("hll-sparse-max-bytes", NULL, MODIFIABLE_CONFIG, 0, LONG_MAX, server.hll_sparse_max_bytes, 3000, MEMORY_CONFIG, NULL, NULL),
     createSizeTConfig("tracking-table-max-keys", NULL, MODIFIABLE_CONFIG, 0, LONG_MAX, server.tracking_table_max_keys, 1000000, INTEGER_CONFIG, NULL, NULL), /* Default: 1 million keys max. */
     createSizeTConfig("client-query-buffer-limit", NULL, DEBUG_CONFIG | MODIFIABLE_CONFIG, 1024*1024, LONG_MAX, server.client_max_querybuf_len, 1024*1024*1024, MEMORY_CONFIG, NULL, NULL), /* Default: 1GB max query buffer. */
+    createSizeTConfig("reply-node-max-bytes", NULL, MODIFIABLE_CONFIG | HIDDEN_CONFIG, 0, LONG_MAX, server.reply_node_max_bytes, CONFIG_DEFAULT_REPLY_NODE_MAX_BYTES, MEMORY_CONFIG, isValidReplyNodeMaxBytes, NULL), /* 0 = replies are not split. */
