+
+# The start of "HSET key field <len-byte value>", up to the value.
+proc win_big_hset_header {key field len} {
+    return "*4\r\n\$4\r\nHSET\r\n\$[string length $key]\r\n$key\r\n\$[string length $field]\r\n$field\r\n\$$len\r\n"
+}
+
+# Sends the start of "HSET key field <len-byte value>" on a raw socket, then
+# keeps sending 1000-byte pieces of the value every 50 ms until a reply line
+# or EOF arrives (5 s at most), and returns the first reply line ("" if the
+# server closed the connection without one). The server only grows the query
+# buffer to the whole value on a read that follows the one holding the
+# header. The first packet carries the header and 2000 bytes, so the header
+# never arrives alone; the pieces after it guarantee that later read however
+# they are coalesced. Raw sockets are plain TCP: callers are tagged tls:skip.
+proc win_raw_big_hset {port key field len} {
+    set fd [socket [srv 0 host] $port]
+    fconfigure $fd -translation binary
+    puts -nonewline $fd [win_big_hset_header $key $field $len]
+    puts -nonewline $fd [string repeat a 2000]
+    flush $fd
+    fconfigure $fd -blocking 0
+    set line ""
+    set sent 2000
+    for {set i 0} {$i < 100} {incr i} {
+        after 50
+        if {[catch {gets $fd line} n]} break
+        if {$n >= 0 || [eof $fd]} break
+        if {$sent + 1000 < $len} {
+            catch {puts -nonewline $fd [string repeat b 1000]; flush $fd}
+            incr sent 1000
+        }
+    }
+    catch {close $fd}
+    return [string trimright $line "\r"]
+}
+
+# A client whose -OOM reply cannot be delivered: it selects the test
+# client's database, pipelines 'count' GETs of 'key' without ever reading the
+# replies, then starts a large HSET and keeps sending pieces of it. Returns
+# the open socket; the caller closes it.
+proc win_raw_stuck_big_hset {port key count} {
+    set fd [socket [srv 0 host] $port]
+    fconfigure $fd -translation binary
+    set db [expr {$::singledb ? 0 : 9}]
+    puts -nonewline $fd "*2\r\n\$6\r\nSELECT\r\n\$[string length $db]\r\n$db\r\n"
+    puts -nonewline $fd [string repeat "*2\r\n\$3\r\nGET\r\n\$[string length $key]\r\n$key\r\n" $count]
+    flush $fd
+    after 200
+    puts -nonewline $fd [win_big_hset_header stuck f 2000000]
+    puts -nonewline $fd [string repeat a 1000]
+    flush $fd
+    fconfigure $fd -blocking 0
+    for {set i 0} {$i < 10} {incr i} {
+        after 50
+        catch {puts -nonewline $fd [string repeat b 1000]; flush $fd}
+    }
+    return $fd
+}
+
+proc win_oom_count {} {
+    return [s client_oom_disconnections]
+}
+
+start_server {tags {"win-soft-oom needs:debug external:skip"} overrides {oom-soft-client-buffers yes}} {
+    set big [win_soft_oom_value 209716] ;# 2,097,160 bytes
+    r hset h data $big small x
+
+    test {Soft OOM: INFO has client_oom_disconnections, and the option is set} {
+        assert_equal 0 [win_oom_count]
+        assert_equal {oom-soft-client-buffers yes} [r config get oom-soft-client-buffers]
+    }
+
+    test {Soft OOM: DEBUG SET-ALLOC-FAIL-THRESHOLD validates its argument} {
+        assert_error {*threshold must be 0*} {r debug set-alloc-fail-threshold -1}
+        assert_error {*not an integer*} {r debug set-alloc-fail-threshold abc}
+        assert_equal OK [r debug set-alloc-fail-threshold 0]
+    }
+
+    test {Soft OOM: a large HMGET reply closes only that client} {
+        r debug set-alloc-fail-threshold 65536
+        set rr [redis_client]
+        catch {$rr hmget h data} e
+        assert_match {*I/O error*} $e
+        catch {$rr close}
+        # Another client, and small replies, are not affected.
+        assert_equal PONG [r ping]
+        assert_equal x [r hget h small]
+        assert_equal 1 [win_oom_count]
+        wait_for_log_messages 0 {"*could not allocate * bytes for its reply (oom-soft-client-buffers)*"} 0 50 100
+        # With the fault injection off the same reply goes through.
+        r debug set-alloc-fail-threshold 0
+        set rr [redis_client]
+        assert_equal [list $big] [$rr hmget h data]
+        $rr close
+        assert_equal 1 [win_oom_count]
+    }
+
+    test {Soft OOM: commands pipelined after the failed reply do not run} {
+        r del after
+        r debug set-alloc-fail-threshold 65536
+        set rd [redis_deferring_client]
+        $rd hget h data
+        $rd set after 1
+        catch {$rd read} e
+        assert_match {*I/O error*} $e
+        catch {$rd close}
+        r debug set-alloc-fail-threshold 0
+        assert_equal 0 [r exists after]
+        assert_equal 2 [win_oom_count]
+    }
+
+    test {Soft OOM: a write inside EXEC runs even when the reply is lost} {
+        r del h2
+        r debug set-alloc-fail-threshold 65536
+        set rr [redis_client]
+        $rr multi
+        $rr hset h2 x 1
+        $rr hget h data
+        catch {$rr exec} e
+        assert_match {*I/O error*} $e
+        catch {$rr close}
+        r debug set-alloc-fail-threshold 0
+        assert_equal 1 [r hget h2 x]
+        assert_equal 3 [win_oom_count]
+    }
+
+    test {Soft OOM: EVAL returning a large value closes the caller, the script client stays fatal} {
+        r debug set-alloc-fail-threshold 65536
+        set rr [redis_client]
+        catch {$rr eval {return redis.call('hget', KEYS[1], 'data')} 1 h} e
+        assert_match {*I/O error*} $e
+        catch {$rr close}
+        # The script ran: its client used the ordinary allocator.
+        assert_equal PONG [r ping]
+        assert_equal 4 [win_oom_count]
+        r debug set-alloc-fail-threshold 0
+        set rr [redis_client]
+        assert_equal $big [$rr eval {return redis.call('hget', KEYS[1], 'data')} 1 h]
+        $rr close
+    }
+
+    tags {tls:skip} {
+    test {Soft OOM: a large HSET query buffer gets -OOM and nothing is written} {
+        r del h3
+        set before [win_oom_count]
+        r debug set-alloc-fail-threshold [expr {1024*1024}]
+        set reply [win_raw_big_hset [srv 0 port] h3 f 2000000]
+        r debug set-alloc-fail-threshold 0
+        assert_match {-OOM could not allocate the query buffer*} $reply
+        assert_equal 0 [r exists h3]
+        assert_equal PONG [r ping]
+        assert_equal [expr {$before + 1}] [win_oom_count]
+    }
+    }
+
+    test {Soft OOM: a large HSET through a regular client is refused and nothing is written} {
+        r del h3
+        set before [win_oom_count]
+        after 1100 ;# one soft OOM log line per second
+        r debug set-alloc-fail-threshold [expr {1024*1024}]
+        # The regular client keeps writing the whole value.
+        set rr [redis_client]
+        catch {$rr hset h3 f $big} e
+        catch {$rr close}
+        assert_equal 0 [r exists h3]
+        assert_equal [expr {$before + 1}] [win_oom_count]
+        wait_for_log_messages 0 {"*could not allocate its query buffer (oom-soft-client-buffers)*pending bulk length: 2097160*"} 0 50 100
+        r debug set-alloc-fail-threshold 0
+        set rr [redis_client]
+        assert_equal 1 [$rr hset h3 f $big]
+        assert_equal $big [$rr hget h3 f]
+        $rr close
+    }
+
+    test {Soft OOM: small requests are unaffected by the threshold} {
+        set before [win_oom_count]
+        r debug set-alloc-fail-threshold 65536
+        set rr [redis_client]
+        for {set j 0} {$j < 100} {incr j} {
+            $rr set k$j [string repeat v 1000]
+        }
+        assert_equal [string repeat v 1000] [$rr get k99]
+        assert_equal x [$rr hget h small]
+        $rr close
+        r debug set-alloc-fail-threshold 0
+        assert_equal $before [win_oom_count]
+    }
+
+    test {Soft OOM: with oom-soft-client-buffers no the threshold has no effect} {
+        set before [win_oom_count]
+        r config set oom-soft-client-buffers no
+        r debug set-alloc-fail-threshold 65536
+        set rr [redis_client]
+        assert_equal [list $big] [$rr hmget h data]
+        r del h4
+        assert_equal 1 [$rr hset h4 f $big]
+        assert_equal $big [$rr hget h4 f]
+        $rr close
+        assert_equal $before [win_oom_count]
+        r debug set-alloc-fail-threshold 0
+        r config set oom-soft-client-buffers yes
+    }
+
+    tags {tls:skip} {
+    test {Soft OOM: a client that cannot receive its -OOM is closed, not polled forever} {
+        set before [win_oom_count]
+        r set big2 [string repeat z 2000000]
+        r debug set-alloc-fail-threshold [expr {1024*1024}]
+        # 20 x 2 MB of unread replies keep the -OOM reply from being written.
+        set fd [win_raw_stuck_big_hset [srv 0 port] big2 20]
+        # The client ran its GETs: its replies are queued, not delivered.
+        wait_for_condition 50 100 {
+            [s client_oom_disconnections] == $before + 1
+        } else {
+            fail "the large HSET did not fail softly"
+        }
+        wait_for_condition 50 100 {
+            [s connected_clients] == 1
+        } else {
+            fail "the client whose -OOM reply could not be written was not closed"
+        }
+        r debug set-alloc-fail-threshold 0
+        set cycles [s eventloop_cycles]
+        after 500
+        # An idle server runs about hz (10) cycles in 500 ms, not millions.
+        assert_lessthan [expr {[s eventloop_cycles] - $cycles}] 1000
+        catch {close $fd}
+        assert_equal 0 [r exists stuck]
+        assert_equal [expr {$before + 1}] [win_oom_count]
+        r del big2
+    }
+    }
+
+    test {Soft OOM: CONFIG RESETSTAT clears client_oom_disconnections} {
+        r config resetstat
+        assert_equal 0 [win_oom_count]
+    }
+}
