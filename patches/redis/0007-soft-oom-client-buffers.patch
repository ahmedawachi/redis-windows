                 }
                 sdsclear(c->querybuf);
@@ -3684,6 +3772,29 @@ void handleClientReadError(client *c) {
                 sdsfree(info);
             }
             break;
+        case CLIENT_READ_QUERYBUF_OOM: {
+            if (c->flags & CLIENT_CLOSE_ASAP) break;
+            /* A later read failed again: the unread request keeps the socket
+             * readable, and the -OOM reply is still queued behind replies the
+             * client is not reading. Close now instead of polling it forever;
+             * the client was already counted. */
+            if (c->flags & CLIENT_CLOSE_AFTER_REPLY) {
+                freeClientAsync(c);
+                break;
+            }
+            if (softOomLogAllowed()) {
+                sds ci = catClientInfoString(sdsempty(),c);
+                serverLog(LL_WARNING,"Closing client that could not allocate its query buffer (oom-soft-client-buffers): %s (pending bulk length: %ld)", ci, c->bulklen);
+                sdsfree(ci);
+            }
+            addReplyError(c,"-OOM could not allocate the query buffer for this request, closing the connection");
+            /* If the reply itself could not be queued, closeClientOnReplyOom()
+             * has already counted this client. */
+            if (!(c->flags & CLIENT_CLOSE_ASAP))
+                atomicIncr(server.stat_client_oom_disconnections, 1);
+            c->flags |= CLIENT_CLOSE_AFTER_REPLY;
+            break;
+        }
         case CLIENT_READ_REACHED_MAX_QUERYBUF: {
             sds ci = catClientInfoString(sdsempty(),c), bytes = sdsempty();
             bytes = sdscatrepr(bytes,c->querybuf,64);
@@ -3996,12 +4107,30 @@ void readQueryFromClient(connection *conn) {
          * need, so using the non-greedy growing. For an initial allocation of
          * the query buffer, we also don't wanna use the greedy growth, in order
          * to avoid collision with the RESIZE_THRESHOLD mechanism. */
-        c->querybuf = sdsMakeRoomForNonGreedy(c->querybuf, readlen);
+        if (clientBuffersMayFailSoftly(c)) {
+            sds qb = querybufTryMakeRoomFor(c->querybuf, readlen, 0);
+            if (unlikely(qb == NULL)) {
+                setQuerybufOomReadError(c);
+                goto done;
+            }
+            c->querybuf = qb;
+        } else {
+            c->querybuf = sdsMakeRoomForNonGreedy(c->querybuf, readlen);
+        }
         /* We later set the peak to the used portion of the buffer, but here we over
          * allocated because we know what we need, make sure it'll not be shrunk before used. */
         if (c->querybuf_peak < qblen + readlen) c->querybuf_peak = qblen + readlen;
     } else {
-        c->querybuf = sdsMakeRoomFor(c->querybuf, readlen);
+        if (clientBuffersMayFailSoftly(c)) {
+            sds qb = querybufTryMakeRoomFor(c->querybuf, readlen, 1);
+            if (unlikely(qb == NULL)) {
+                setQuerybufOomReadError(c);
+                goto done;
+            }
+            c->querybuf = qb;
+        } else {
+            c->querybuf = sdsMakeRoomFor(c->querybuf, readlen);
+        }
 
         /* Read as much as possible from the socket to save read(2) system calls. */
         readlen = sdsavail(c->querybuf);
