+/* -----------------------------------------------------------------------------
+ * oom-soft-client-buffers: client buffers that fail softly.
+ *
+ * With the option on, the reply list nodes and the query buffer of a real
+ * socket client are allocated with the try-allocators. When such an
+ * allocation fails, only that client is closed; the server does not abort.
+ * Masters, replicas, monitors and fake clients (Lua, modules, AOF loading)
+ * keep the aborting allocators, like every other allocation.
+ * -------------------------------------------------------------------------- */
+
+static inline int clientBuffersMayFailSoftly(client *c) {
+    return server.oom_soft_client_buffers && c->conn &&
+           !(c->flags & (CLIENT_MASTER|CLIENT_SLAVE|CLIENT_SCRIPT|CLIENT_MODULE));
+}
+
+/* Fault injection (DEBUG SET-ALLOC-FAIL-THRESHOLD): make a soft allocation
+ * of 'size' bytes or more fail. It never affects any other allocation. */
+static inline int softClientAllocMustFail(size_t size) {
+    size_t threshold = server.client_alloc_fail_threshold;
+    return threshold && size >= threshold;
+}
+
+/* Soft variant of sdsMakeRoomFor() / sdsMakeRoomForNonGreedy() for query
+ * buffers. Returns NULL, leaving 's' unchanged, when the allocation fails. */
+static sds querybufTryMakeRoomFor(sds s, size_t addlen, int greedy) {
+    if (sdsavail(s) >= addlen) return s;
+    if (softClientAllocMustFail(sdslen(s) + addlen)) return NULL;
+    return greedy ? sdsTryMakeRoomFor(s, addlen) : sdsTryMakeRoomForNonGreedy(s, addlen);
+}
+
+/* Log at most one soft OOM line per second; INFO has the exact count. */
+static int softOomLogAllowed(void) {
+    static time_t last_log = 0;
+    if (last_log == server.unixtime) return 0;
+    last_log = server.unixtime;
+    return 1;
+}
+
+/* A reply list node could not be allocated. The command has already run, so
+ * its reply is lost, as it would be on a network drop: close the client once
+ * the current command returns. */
+static void closeClientOnReplyOom(client *c, size_t size) {
+    if (c->flags & CLIENT_CLOSE_ASAP) return;
+    freeClientAsync(c);
+    atomicIncr(server.stat_client_oom_disconnections, 1);
+    if (softOomLogAllowed()) {
+        sds client = catClientInfoString(sdsempty(),c);
+        serverLog(LL_WARNING,
+                  "Client %s scheduled to be closed ASAP: could not allocate %zu bytes for its reply (oom-soft-client-buffers).",
+                  client, size);
+        sdsfree(client);
+    }
+}
+
+/* The query buffer could not grow. Nothing of the request has run yet;
+ * handleClientReadError() replies -OOM and closes the client. */
+static void setQuerybufOomReadError(client *c) {
+    c->read_error = CLIENT_READ_QUERYBUF_OOM;
+    if (c->running_tid != IOTHREAD_MAIN_THREAD_ID)
+        enqueuePendingClientsToMainThread(c, 0);
+}
+
